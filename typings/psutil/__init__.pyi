"""Closed declarations for the existing pinned native process probe dependency."""

import sys
from collections.abc import Callable, Iterable, Iterator
from typing import IO, Any

class Error(Exception): ...
class NoSuchProcess(Error): ...
class ZombieProcess(NoSuchProcess): ...
class AccessDenied(Error): ...

CONN_LISTEN: str
CONN_NONE: str

class _ProcessCpuTimes:
    user: float
    system: float

class _MemoryInfo:
    rss: int

class _IoCounters:
    read_bytes: int
    write_bytes: int

class _VirtualMemory:
    total: int
    available: int

class _DiskUsage:
    total: int
    used: int
    free: int

class _Address:
    ip: str
    port: int

class _Connection:
    laddr: _Address | tuple[()]
    raddr: _Address | tuple[()]
    status: str
    pid: int | None

class Process:
    # Set by process_iter(attrs) to the requested as_dict() values.
    info: dict[str, Any]
    def __init__(self, pid: int | None = ...) -> None: ...
    @property
    def pid(self) -> int: ...
    def name(self) -> str: ...
    def exe(self) -> str: ...
    def username(self) -> str: ...
    def create_time(self) -> float: ...
    def is_running(self) -> bool: ...
    def children(self, recursive: bool = ...) -> list[Process]: ...
    def parent(self) -> Process | None: ...
    def cpu_percent(self, interval: float | None = ...) -> float: ...
    def cpu_times(self) -> _ProcessCpuTimes: ...
    def memory_info(self) -> _MemoryInfo: ...
    if sys.platform != "darwin":
        def io_counters(self) -> _IoCounters: ...

    def terminate(self) -> None: ...
    def kill(self) -> None: ...
    def wait(self, timeout: float | None = ...) -> int | None: ...

class Popen(Process):
    # Unknown attributes delegate to the wrapped subprocess.Popen at runtime.
    stdin: IO[bytes] | None
    stdout: IO[bytes] | None
    stderr: IO[bytes] | None
    returncode: int | None
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    def poll(self) -> int | None: ...

def pid_exists(pid: int) -> bool: ...
def process_iter(attrs: list[str] | None = ..., ad_value: object = ...) -> Iterator[Process]: ...
def wait_procs(
    procs: Iterable[Process],
    timeout: float | None = ...,
    callback: Callable[[Process], object] | None = ...,
) -> tuple[list[Process], list[Process]]: ...
def cpu_count(logical: bool = ...) -> int | None: ...
def cpu_percent(interval: float | None = ...) -> float: ...
def virtual_memory() -> _VirtualMemory: ...
def disk_usage(path: str) -> _DiskUsage: ...
def net_connections(kind: str = ...) -> list[_Connection]: ...

if sys.platform == "win32":
    class WindowsService:
        def pid(self) -> int | None: ...

    def win_service_get(name: str) -> WindowsService: ...
