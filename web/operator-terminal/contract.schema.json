{
  "$defs": {
    "Freshness": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "AVAILABLE",
            "UNKNOWN",
            "UNAVAILABLE",
            "STALE"
          ],
          "title": "State",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "provenance": {
          "enum": [
            "LOCAL_DIAGNOSTICS",
            "UNCONNECTED",
            "ISOLATED_SYNTHETIC_PAPER",
            "REVIEWED_ENGINEERING"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "reason": {
          "enum": [
            "CURRENT",
            "NOT_CONNECTED",
            "READ_UNAVAILABLE",
            "SOURCE_STALE",
            "REVIEWED_SUMMARY",
            "NO_EVENTS"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "state",
        "provenance",
        "reason"
      ],
      "title": "Freshness",
      "type": "object"
    },
    "JournalEvent": {
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "reason": {
          "enum": [
            "AUTHORIZED",
            "DENIED",
            "KILL_STATE",
            "RECONCILIATION",
            "UNKNOWN_ORDER",
            "LOSS_LATCH",
            "DISPATCH_ATTEMPT",
            "OWNER_RESUME",
            "MARK_HEALTH",
            "WRITER_ACQUIRED",
            "OWNER_PIN",
            "EDGE_STATE",
            "DAY_ROLLOVER",
            "INITIALIZED",
            "OTHER"
          ],
          "title": "Reason",
          "type": "string"
        },
        "intent_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intent Hash"
        },
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "observed_at",
        "reason",
        "evidence_hash"
      ],
      "title": "JournalEvent",
      "type": "object"
    },
    "JournalView": {
      "additionalProperties": false,
      "properties": {
        "freshness": {
          "$ref": "#/$defs/Freshness"
        },
        "events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/JournalEvent"
          },
          "maxItems": 100,
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "freshness"
      ],
      "title": "JournalView",
      "type": "object"
    },
    "PaperView": {
      "additionalProperties": false,
      "properties": {
        "freshness": {
          "$ref": "#/$defs/Freshness"
        },
        "balance": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,18})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Balance"
        },
        "equity": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,18})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equity"
        },
        "currency": {
          "anyOf": [
            {
              "enum": [
                "USD",
                "UNCLASSIFIED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "kill": {
          "anyOf": [
            {
              "enum": [
                "K0",
                "K1",
                "K2",
                "K3",
                "K4"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kill"
        },
        "reconciled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reconciled"
        },
        "unknown_orders": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Orders"
        },
        "active_reservations": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Reservations"
        },
        "reservations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReservationView"
          },
          "maxItems": 100,
          "title": "Reservations",
          "type": "array"
        },
        "positions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PositionView"
          },
          "maxItems": 100,
          "title": "Positions",
          "type": "array"
        },
        "pending": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PendingView"
          },
          "maxItems": 100,
          "title": "Pending",
          "type": "array"
        }
      },
      "required": [
        "freshness"
      ],
      "title": "PaperView",
      "type": "object"
    },
    "PendingView": {
