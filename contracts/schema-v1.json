{
  "ExecutionReport": {
    "additionalProperties": false,
    "description": "An externally observed fact shape; never emitted as a fake broker result.",
    "properties": {
      "attempt_id": {
        "format": "uuid",
        "title": "Attempt Id",
        "type": "string"
      },
      "broker_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Broker At"
      },
      "broker_deal_ref": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Broker Deal Ref"
      },
      "broker_order_ref": {
        "anyOf": [
          {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Broker Order Ref"
      },
      "fees": {
        "ge": 0,
        "title": "Fees",
        "type": "string"
      },
      "filled_quantity": {
        "ge": 0,
        "title": "Filled Quantity",
        "type": "string"
      },
      "intent_id": {
        "format": "uuid",
        "title": "Intent Id",
        "type": "string"
      },
      "raw_response_hash": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Raw Response Hash",
        "type": "string"
      },
      "received_at": {
        "format": "date-time",
        "title": "Received At",
        "type": "string"
      },
      "report_id": {
        "format": "uuid",
        "title": "Report Id",
        "type": "string"
      },
      "requested_quantity": {
        "gt": 0,
        "title": "Requested Quantity",
        "type": "string"
      },
      "schema_version": {
        "const": "1.0",
        "default": "1.0",
        "title": "Schema Version",
        "type": "string"
      },
      "status": {
        "enum": [
          "ACKNOWLEDGED",
          "REJECTED",
          "UNKNOWN",
          "PARTIALLY_FILLED",
          "FILLED",
          "CANCELED",
          "EXPIRED"
        ],
        "title": "Status",
        "type": "string"
      }
    },
    "required": [
      "report_id",
      "intent_id",
      "attempt_id",
      "broker_order_ref",
      "broker_deal_ref",
      "received_at",
      "broker_at",
      "status",
      "requested_quantity",
      "filled_quantity",
      "fees",
      "raw_response_hash"
    ],
    "title": "ExecutionReport",
    "type": "object"
  },
  "FeatureSnapshot": {
    "additionalProperties": false,
    "properties": {
      "as_of": {
        "format": "date-time",
        "title": "As Of",
        "type": "string"
      },
      "available_at": {
        "format": "date-time",
        "title": "Available At",
        "type": "string"
      },
      "code_hash": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Code Hash",
        "type": "string"
      },
      "dataset_version": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Dataset Version",
        "type": "string"
      },
      "decision_at": {
        "format": "date-time",
        "title": "Decision At",
        "type": "string"
      },
      "feature_snapshot_id": {
        "format": "uuid",
        "title": "Feature Snapshot Id",
        "type": "string"
      },
      "feature_version": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
        "title": "Feature Version",
        "type": "string"
      },
      "health": {
        "enum": [
          "HEALTHY",
          "STALE",
          "GAPPED",
          "UNKNOWN"
        ],
        "title": "Health",
        "type": "string"
      },
      "instrument_id": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
        "title": "Instrument Id",
        "type": "string"
      },
      "market_state_id": {
        "format": "uuid",
        "title": "Market State Id",
        "type": "string"
      },
      "missing_features": {
        "default": [],
        "items": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$",
          "type": "string"
        },
        "title": "Missing Features",
        "type": "array"
      },
      "schema_version": {
        "const": "1.0",
        "default": "1.0",
        "title": "Schema Version",
        "type": "string"
      },
      "source_watermark": {
        "format": "date-time",
        "title": "Source Watermark",
        "type": "string"
      }
    },
    "required": [
      "market_state_id",
      "instrument_id",
      "as_of",
      "available_at",
      "decision_at",
      "source_watermark",
      "dataset_version",
      "health",
      "feature_snapshot_id",
      "feature_version",
      "code_hash"
    ],
    "title": "FeatureSnapshot",
    "type": "object"
  },
